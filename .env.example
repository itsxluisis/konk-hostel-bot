# ───── Vapi ─────
# Secret compartido que Vapi envía en cada webhook (header x-vapi-secret).
# Protege todos los endpoints /vapi/* y las rutas /admin/*. Sin esta variable,
# esas rutas responden 503 (fail-closed) en vez de dejar pasar sin auth.
VAPI_SECRET=cambia_esto_por_un_secreto_largo
# TEMPORAL — solo mientras se rota VAPI_SECRET. vapiAuth/legacyAuthOk aceptan
# también este valor además del VAPI_SECRET actual, para poder cambiar el
# secreto en EasyPanel sin cortar el bot mientras Vapi todavía manda el
# viejo. Procedimiento: 1) desplegar con el código que soporta rotación,
# 2) poner aquí (EasyPanel) el secreto VIEJO y VAPI_SECRET al NUEVO,
# 3) actualizar el secreto en Vapi (tools + assistant), 4) llamada de
# prueba, 5) borrar esta variable. /health expone vapiSecretPreviousActive
# (booleano) mientras esté definida.
# VAPI_SECRET_PREVIOUS=
# API key de la cuenta Vapi — usada por el backend para hablar con la API de
# Vapi en nombre del panel admin (proxy /admin/vapi/*, ver src/vapi-proxy.js).
# Desde la Tanda V1 el navegador NUNCA recibe este valor.
VAPI_API_KEY=
# Modo de autenticación de los tools "legacy" de Vapi que aún no tienen
# confirmado que manden x-vapi-secret: el informe de fin de llamada
# (end-of-call-report en /vapi/assistant-config) y /vapi/get-weather.
# 'warn' (por defecto; deja pasar sin secreto válido, loguea y manda un aviso
# a Telegram) o 'strict' (rechaza con 401). NO pasar a 'strict' hasta activar
# server.secret en el assistant de Vapi para ambos tools — a día de hoy
# (23-sep-2026) no está confirmado que Vapi mande x-vapi-secret con ellos.
# VAPI_END_OF_CALL_AUTH sigue funcionando como alias de compatibilidad si
# VAPI_LEGACY_AUTH no está definida.
# VAPI_LEGACY_AUTH=warn

# ───── Cloudbeds (OAuth 2.0) ─────
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_REDIRECT_URI=https://tu-dominio.com/auth/cloudbeds/callback
CLOUDBEDS_PROPERTY_ID=
# Se obtienen tras autorizar: GET /auth/cloudbeds con cabecera x-vapi-secret
# devuelve la URL de Cloudbeds (el secreto ya no se acepta por query string).
CLOUDBEDS_ACCESS_TOKEN=
CLOUDBEDS_REFRESH_TOKEN=

# ───── Panel admin ─────
ADMIN_USER=admin
ADMIN_PASSWORD=

# ───── Telegram (resumen de llamadas) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───── Encargado (vigilancia de agentes locales) ─────
# Secret para autenticar latidos de agentes. RECOMENDADO: un valor propio,
# distinto de VAPI_SECRET (así rotar uno no afecta al otro). Si se deja sin
# definir, cae en VAPI_SECRET por compatibilidad y se avisa en el arranque
# (/health → encargadoSecretDedicated: false).
# ENCARGADO_SECRET=cambia_esto_por_un_secreto_largo_distinto_de_vapi_secret
# Carpeta donde guardar encargado.json (por defecto ./data).
# ENCARGADO_DATA_DIR=./data
# IDs de temas de Telegram para organizar mensajes (opcionales; vacío = todo al tema General).
# TG_TEMA_ESTADO=
# TG_TEMA_PARTE=
# TG_TEMA_ALERTAS=
# TG_TEMA_LLAMADAS=
# TG_TEMA_COBROS=
# TG_TEMA_FACTURAS=
# TG_TEMA_PREGUNTAR=

# ───── Servidor ─────
PORT=80
